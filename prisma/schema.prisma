generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model News {
  id              Int         @id @default(autoincrement())
  title           String
  content         String
  contentMd5      String      @unique
  sourceUrl       String
  disabled        Boolean     @default(false)
  publishDateTime DateTime
  remark          String?
  priority        Int?
  nature          NewsNature?
  newsType        NewsType    @default(Rolling)
  createdAt       DateTime?   @default(now())
  updatedAt       DateTime?   @updatedAt
}

model Crawler {
  id           Int           @id @default(autoincrement())
  cmdPrefix    String
  scriptPath   String
  language     Language
  cron         String        @default("0 10 6 * * *")
  disabled     Boolean       @default(false)
  remark       String?
  createdAt    DateTime?     @default(now())
  updatedAt    DateTime?     @updatedAt
  crawlResults CrawlResult[]
}

model CrawlResult {
  id          Int       @id @default(autoincrement())
  crawler     Crawler   @relation(fields: [crawlerId], references: [id])
  crawlerId   Int
  successFlag Boolean
  message     String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

model LLMChatResult {
  id             Int       @id @default(autoincrement())
  newsIds        String
  completionBody String
  message        String?
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @updatedAt
}

model PushSchedule {
  id          Int          @id @default(autoincrement())
  cron        String
  messageType MessageType
  channel     PushChannel
  to          String
  disabled    Boolean      @default(false)
  remark      String?
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt
  pushResults PushResult[]
}

model PushResult {
  id         Int          @id @default(autoincrement())
  schedule   PushSchedule @relation(fields: [scheduleId], references: [id])
  scheduleId Int
  content    String
  to         String
  resultCode Int
  createdAt  DateTime?    @default(now())
  updatedAt  DateTime?    @updatedAt
}

model Config {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  val       String
  remark    String?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

enum Language {
  PY
  JS
}

enum NewsNature {
  DOM
  INTL
}

enum NewsType {
  Paper // 简报新闻：一次爬取到的日期相同的一组新闻，这种新闻的日期不一定是其发布日期，因此在日期筛选上限制更加严格
  Rolling // 滚动新闻：一次爬取到的日期各自不同的新闻，这种新闻可以按其发布时间进行筛选
}

enum MessageType {
  NEWS
}

enum PushChannel {
  WE_CHAT
}
