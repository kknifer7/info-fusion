    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.1",
    "cron": "^4.4.0",
    "cross-env": "^10.1.0",
    "fast-equals": "^6.0.0",
    "openai": "^6.39.1",
